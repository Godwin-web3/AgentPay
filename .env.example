# Arc network
ARC_RPC=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
USDC_CONTRACT=0x3600000000000000000000000000000000000000
USDC_DECIMALS=6

# Operator signing key (aggregates per-user vault execution; rotate via 2-step
# VaultFactory agent rotation). DO NOT commit real values.
PRIVATE_KEY=
AGENT_ADDRESS=
AGENT_WALLET_ID=

# Circle Programable Wallets
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=

# LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Operator API (Render)
PORT=3000
# Shared secret required between Render service and Cloudflare Worker.
# Generate with: openssl rand -hex 32. Frontend obtains a per-user key out-of-band.
APP_API_KEY=
# Frontend mirror of APP_API_KEY (must match). Set in frontend/.env as VITE_APP_API_KEY.
VITE_APP_API_KEY=

# Deployed contract addresses
VAULT_FACTORY_ADDRESS=
VAULT_ADDRESS=
AGENTIC_COMMERCE_CONTRACT=
# On-chain decision-provenance log (contracts/DecisionLog.sol). Deploy with
# scripts/deployDecisionLog.js after scripts/compile.js.
DECISION_LOG_ADDRESS=

# Two-agent marketplace daemon (scripts/marketplace-agent.js). Shared secret
# agreed out-of-band with a partner AgentPay operator — NOT the same as
# APP_API_KEY, which is this deployment's own Worker<->Render secret.
MARKETPLACE_API_KEY=
MARKETPLACE_POLL_MS=30000

# Worker (Cloudflare)
NODE_SERVER_URL=https://your-render-service.onrender.com

# Optional fallback oracle
PYTH_HERMES_URL=https://hermes.pyth.network
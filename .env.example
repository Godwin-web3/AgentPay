# Active chain: arc | base-sepolia
CHAIN=arc

# Arc network (used when CHAIN=arc)
ARC_RPC=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
USDC_CONTRACT=0x3600000000000000000000000000000000000000
# ERC-20 interface decimals. On Arc this is 6. Native gas USDC is 18.
# Vault accounting uses this value, never the native gas decimals.
USDC_DECIMALS=6

# Optional second chain (used when CHAIN=base-sepolia)
# BASE_SEPOLIA_RPC=https://sepolia.base.org
# BASE_SEPOLIA_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Operator signing key (aggregates per-user vault execution; rotate via 2-step
# VaultFactory agent rotation). DO NOT commit real values.
PRIVATE_KEY=
AGENT_ADDRESS=
AGENT_WALLET_ID=

# Circle Programmable Wallets
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=

# LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Operator API (Render)
PORT=3000
# Shared secret required between Render service and Cloudflare Worker.
# Generate with: openssl rand -hex 32. Frontend obtains a per-user key out-of-band.
APP_API_KEY=
# Frontend mirror of APP_API_KEY (must match). Set in frontend/.env as VITE_APP_API_KEY.
VITE_APP_API_KEY=

# Deployed contract addresses
VAULT_FACTORY_ADDRESS=
VAULT_ADDRESS=
AGENTIC_COMMERCE_CONTRACT=
DECISION_LOG_ADDRESS=
POOL_VAULT_ADDRESS=

# Two-agent marketplace daemon (scripts/marketplace-agent.js).
MARKETPLACE_API_KEY=
MARKETPLACE_POLL_MS=30000

# Worker (Cloudflare)
NODE_SERVER_URL=https://your-render-service.onrender.com

# Optional fallback oracle
PYTH_HERMES_URL=https://hermes.pyth.network

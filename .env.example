# Arc network
ARC_RPC=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
USDC_CONTRACT=0x3600000000000000000000000000000000000000
USDC_DECIMALS=6

# Active chain for reads, deploys, and vault execution.
# arc (default) | base | ethereum | robinhood
# Leave unset to stay on Arc. Set RPC_URL to override that chain's public RPC.
CHAIN=arc
# RPC_URL=
# Set to 0 to stop the server from deploying a Base vault on boot.
# It deploys only once, only if the operator key has at least 0.0008 ETH on Base,
# and only if Firestore can remember the addresses.
BOOTSTRAP_BASE=1

# VAULT_ADDRESS_BASE=
# SWAP_EXECUTOR_BASE=
# VAULT_ADDRESS_ETHEREUM=
# SWAP_EXECUTOR_ETHEREUM=
# VAULT_ADDRESS_ROBINHOOD=
# SWAP_EXECUTOR_ROBINHOOD=

# Operator signing key (aggregates per-user vault execution; rotate via 2-step
# VaultFactory agent rotation). DO NOT commit real values.
PRIVATE_KEY=
AGENT_ADDRESS=
AGENT_WALLET_ID=

# Circle Programable Wallets
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=

# LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Operator API (Render)
PORT=3000
# Shared secret required between Render service and Cloudflare Worker.
# Generate with: openssl rand -hex 32. Frontend obtains a per-user key out-of-band.
APP_API_KEY=
# Frontend mirror of APP_API_KEY (must match). Set in frontend/.env as VITE_APP_API_KEY.
VITE_APP_API_KEY=

# Deployed contract addresses
VAULT_FACTORY_ADDRESS=
VAULT_ADDRESS=
AGENTIC_COMMERCE_CONTRACT=
# On-chain decision-provenance log (contracts/DecisionLog.sol). Deploy with
# scripts/deployDecisionLog.js after scripts/compile.js.
DECISION_LOG_ADDRESS=
# Singleton shared-money pools (contracts/PoolVault.sol). Deploy with
# scripts/deployPoolVault.js after scripts/compile.js.
POOL_VAULT_ADDRESS=

# Worker (Cloudflare)
NODE_SERVER_URL=https://your-render-service.onrender.com

# Optional fallback oracle
PYTH_HERMES_URL=https://hermes.pyth.network

# Optional quote providers (side-effect free; set to real aggregator/bridge/DeFi endpoints)
QUOTE_SWAP_URL=
QUOTE_BRIDGE_URL=
DEFI_QUOTE_URL=
